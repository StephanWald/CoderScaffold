// CoderScaffold maintainer devcontainer.
// Equips a maintainer of THIS repo with: Docker Compose, Terraform (for template
// validation), shellcheck (for script linting), and Claude Code (AI assistant).
//
// The javascript-node base image is kept for its Node.js/npm, which the GSD
// toolchain (npx @opengsd/gsd-core) requires.
//
// Feature major-version pins (":1") below resolve to a specific patch at build
// time. The lock file only covers claude-code today (1.0.5). docker-outside-of-docker
// and terraform feature versions are best-effort and should be verified on first
// devcontainer rebuild. Run `devcontainer upgrade` or inspect the rebuilt lock to
// confirm resolved versions before relying on them in production.
{
	"name": "CoderScaffold Maintainer",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",

	"features": {
		// Keep claude-code:1.0 EXACTLY — devcontainer-lock.json pins it to 1.0.5;
		// bumping this key would invalidate the lock.
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// Docker CLI that talks to the host daemon so `docker compose` works.
		// Preferred over docker-in-docker for a maintainer box driving compose on the host.
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		// Terraform/OpenTofu + tooling for `terraform fmt`/`validate` on templates/.
		"ghcr.io/devcontainers/features/terraform:1": {}
	},

	// Post-create setup, chained with `;` so no single failure aborts the rest;
	// each risky step ends in a WARN-and-continue fallback (non-fatal):
	//   1. shellcheck for bash script linting (the terraform feature lacks it).
	//   2. mempalace CLI in a private venv ($HOME/.mempalace-venv), symlinked to
	//      /usr/local/bin — mirrors the workspace-image idiom; guarded on python3
	//      (the javascript-node base does not guarantee it).
	//   3. mempalace MCP server registration: node-merges mcpServers.mempalace
	//      into ~/.claude.json (same merge idiom the workspace templates use).
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y shellcheck || echo 'WARN: shellcheck install failed; continuing'; command -v python3 >/dev/null 2>&1 && python3 -m venv \"$HOME/.mempalace-venv\" && \"$HOME/.mempalace-venv/bin/pip\" install --no-cache-dir mempalace && sudo ln -sf \"$HOME/.mempalace-venv/bin/mempalace\" /usr/local/bin/mempalace || echo 'WARN: mempalace install skipped (no python3 or install failed); continuing'; command -v node >/dev/null 2>&1 && node -e 'const fs=require(\"fs\"),p=require(\"os\").homedir()+\"/.claude.json\";let c={};try{c=JSON.parse(fs.readFileSync(p,\"utf8\")||\"{}\")}catch{}c.mcpServers=c.mcpServers||{};c.mcpServers.mempalace={command:\"mempalace\",args:[\"mcp\",\"serve\"]};fs.writeFileSync(p,JSON.stringify(c,null,2))' || echo 'WARN: mempalace MCP registration skipped; continuing'",

	"mounts": [
		"source=claude-code-config,target=/home/node/.claude,type=volume"
	]
}
